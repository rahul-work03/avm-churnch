# -------------------------------------------------------------
# Database Connection (SQLite)
# -------------------------------------------------------------
# Local SQLite database file path:
DATABASE_URL=file:./payload.db

# -------------------------------------------------------------
# Payload Security Secrets
# -------------------------------------------------------------
# Used by Payload CMS to sign & encrypt authentication JWT tokens and admin cookies:
PAYLOAD_SECRET=128c97a5a78fc3fcf4f8be003a7f0dc562cfb2118e1d3ec38d4a288609aa90c7

# Used for authenticating background Payload cron jobs:
CRON_SECRET=7fff50b76071480a8e787305222706c6

# Used to validate secure draft live preview requests from Payload Admin:
PREVIEW_SECRET=878d6db7498da2e39f634e929e7ed771

# -------------------------------------------------------------
# Server & Public URLs (No trailing slash)
# -------------------------------------------------------------
# Local development:
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Production (uncomment and set when deploying):
# NEXT_PUBLIC_SERVER_URL=https://ankurnarula.org

# -------------------------------------------------------------
# Email Configuration (Nodemailer / Gmail App Password & Console)
# -------------------------------------------------------------
# Set EMAIL_BACKEND to 'console' to log emails to terminal during testing,
# or 'smtp' to send live emails via Gmail App Password.
EMAIL_BACKEND=console
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Ankur Narula Ministries <your-email@gmail.com>
# Where notification emails are delivered (comma-separated):
EMAIL_TO=admin@ankurnarulaministries.com
# Optional CC and BCC (comma-separated):
EMAIL_CC=
EMAIL_BCC=
# Optional form-specific recipient overrides:
# PRAYER_REQUEST_EMAIL_TO=prayer@ankurnarulaministries.com
# ZOOM_REGISTRATION_EMAIL_TO=zoom@ankurnarulaministries.com
# CONTACT_US_EMAIL_TO=contact@ankurnarulaministries.com
# STORE_ORDER_EMAIL_TO=store@ankurnarulaministries.com

# -------------------------------------------------------------
# Instamojo Payment Gateway (OAuth 2.0 & v2 REST API)
# -------------------------------------------------------------
# Obtain Client ID & Client Secret from Instamojo Dashboard > API & Plugins
INSTAMOJO_CLIENT_ID="your-client-id"
INSTAMOJO_CLIENT_SECRET="your-client-secret"
# Base URL: https://api.instamojo.com (Production) or https://test.instamojo.com (Sandbox Test)
INSTAMOJO_API_BASE_URL="https://api.instamojo.com"
# Optional Private Salt for verifying webhook HMAC-SHA1 signature:
INSTAMOJO_PRIVATE_SALT=
# Optional Public Webhook URL override (e.g. for ngrok testing in local development):
# Instamojo rejects "localhost" and "127.0.0.1" for webhooks. If unset on localhost, webhook is safely omitted.
# INSTAMOJO_WEBHOOK_URL="https://your-domain.ngrok-free.app/api/store/instamojo-webhook"