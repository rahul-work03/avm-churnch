# -----------------------------------------------------------------------------
# Docker Environment Variables for AVM Church (Next.js + Payload CMS)
# -----------------------------------------------------------------------------

# Database Connection (MongoDB service in docker-compose network):
DATABASE_URL=mongodb://mongo:27017/avm-church

# Alternatively, if using SQLite inside container:
# DATABASE_URL=file:/app/data/payload.db

# Payload Security Secrets (generate 32+ char hex strings):
PAYLOAD_SECRET=128c97a5a78fc3fcf4f8be003a7f0dc562cfb2118e1d3ec38d4a288609aa90c7
CRON_SECRET=7fff50b76071480a8e787305222706c6
PREVIEW_SECRET=878d6db7498da2e39f634e929e7ed771

# Public Server URL (used for CORS and media links):
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Port on host machine:
PORT=3000
