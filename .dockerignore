# Environment files (injected at runtime via docker-compose or orchestration)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Git & IDE files
.git
.gitignore
.gitattributes
.vscode
.idea
*.DS_Store
Thumbs.db
*.tsbuildinfo

# Documentation / Markdown scratches
*.md
!README.md
