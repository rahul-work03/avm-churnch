# Dependencies & package manager
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build output & cache
.next
out
build
dist
.swc

# Local databases & uploads (handled via persistent Docker volumes)
payload.db
payload.db-journal
public/media/*
